---
layout: layouts/base.njk
permalink: index.html
---

<header class="fixed top-0 left-0 w-full z-[1000] bg-dark/85 backdrop-blur-[10px] transition-colors duration-300" id="top">
  <nav class="max-w-[1200px] mx-auto px-6 flex items-center justify-between h-[4.5rem]">
    <a href="#top" class="font-heading text-[1.6rem] font-bold text-white tracking-wide">{{ site.brand.name }}<span class="text-accent">{{ site.brand.highlight }}</span></a>

    <input type="checkbox" id="nav-toggle" class="nav-checkbox" />
    <label for="nav-toggle" class="nav-hamburger">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <ul class="nav-menu flex items-center gap-8 list-none">
      {% for link in site.nav.links %}
      <li>
        <a href="{{ link.href }}" class="nav-link text-white/85 text-[0.95rem] font-medium relative py-1 hover:text-white transition-colors duration-300">{{ link.label }}</a>
      </li>
      {% endfor %}
      <li>
        <a href="{{ site.nav.ctaHref }}" class="bg-accent text-dark px-5 py-2 rounded-lg font-semibold hover:bg-coffee-light hover:text-white transition-all duration-300">{{ site.nav.ctaLabel }}</a>
      </li>
    </ul>
  </nav>
</header>

<section class="hero-bg relative min-h-screen flex items-center justify-center text-white" id="hero">
  <div class="absolute inset-0 bg-gradient-to-b from-dark/70 via-dark/50 to-dark/80"></div>
  <div class="relative z-10 text-center max-w-[1200px] mx-auto px-6 py-8">
    <p class="font-body text-[1.15rem] font-medium tracking-[3px] uppercase text-accent mb-3">{{ site.hero.subtitle }}</p>
    <h1 class="font-heading text-[4.5rem] font-bold leading-[1.1] mb-5 max-md:text-[2.5rem] max-lg:text-[3.2rem]">{{ site.hero.title }}</h1>
    <p class="text-[1.2rem] leading-relaxed text-white/85 mb-10">{{ site.hero.text | safe }}</p>
    <div class="flex gap-4 justify-center flex-wrap max-md:flex-col max-md:items-center">
      <a href="{{ site.hero.primaryButton.href }}" class="inline-block px-8 py-3.5 rounded-lg font-semibold bg-accent text-dark border-2 border-accent hover:bg-coffee hover:text-white hover:border-coffee transition-all duration-300 max-md:w-full max-md:max-w-[280px] text-center">{{ site.hero.primaryButton.label }}</a>
      <a href="{{ site.hero.secondaryButton.href }}" class="inline-block px-8 py-3.5 rounded-lg font-semibold bg-transparent text-white border-2 border-white hover:bg-white hover:text-coffee-dark transition-all duration-300 max-md:w-full max-md:max-w-[280px] text-center">{{ site.hero.secondaryButton.label }}</a>
    </div>
  </div>
</section>

<div class="hidden max-md:block bg-coffee text-white text-center py-4">
  <div class="max-w-[1200px] mx-auto px-5">
    <p class="text-[0.9rem] leading-normal">
      🌟 <strong class="text-accent">{{ site.mobileBanner.highlight }}</strong> {{ site.mobileBanner.text }}
    </p>
  </div>
</div>

<section class="py-24 max-md:py-14 bg-cream" id="about">
  <div class="max-w-[1200px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    <div class="overflow-hidden">
      <img src="/{{ site.about.image }}" alt="{{ site.about.imageAlt }}" class="w-full rounded-card shadow-[0_20px_50px_rgba(0,0,0,0.1)] max-lg:max-h-[400px] object-cover" />
    </div>
    <div>
      <h2 class="font-heading text-[2.5rem] max-md:text-[1.85rem] font-bold text-coffee-dark mb-4 lg:text-left text-center">{{ site.about.title }}</h2>
      {% for paragraph in site.about.paragraphs %}
      <p class="text-text-light text-[1.05rem] max-md:text-[0.95rem] leading-[1.8] mb-5">{{ paragraph }}</p>
      {% endfor %}
      <div class="flex gap-10 max-md:gap-6 mt-8 flex-wrap max-[480px]:flex-col max-[480px]:gap-4">
        {% for stat in site.about.stats %}
        <div class="flex flex-col">
          <span class="font-heading text-[2rem] max-md:text-[1.6rem] font-bold text-coffee">{{ stat.number }}</span>
          <span class="text-[0.85rem] text-text-light mt-1">{{ stat.label }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section class="py-24 max-md:py-14 bg-cream-alt" id="menu">
  <div class="max-w-[1200px] mx-auto px-6">
    <h2 class="font-heading text-[2.5rem] max-md:text-[1.85rem] font-bold text-coffee-dark text-center mb-4">{{ site.menu.title }}</h2>
    <p class="text-center text-text-light text-[1.1rem] max-md:text-[1rem] max-w-[750px] mx-auto mb-12 max-md:mb-8">{{ site.menu.subtitle }}</p>

    <div class="grid grid-cols-4 max-lg:grid-cols-2 max-md:grid-cols-1 gap-8 max-md:gap-5">
      {% for item in collections.menu %}
      {% if item.data.active %}
      <article class="menu-card bg-white rounded-card overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.06)] hover:-translate-y-1.5 hover:shadow-[0_12px_32px_rgba(0,0,0,0.12)] transition-all duration-300 max-md:flex max-md:flex-row">
        <div class="overflow-hidden h-[200px] max-md:w-[120px] max-md:min-h-[120px] max-md:h-auto max-md:shrink-0 max-[480px]:w-[100px] max-[480px]:min-h-[100px]">
          <img src="{{ item.data.image }}" alt="{{ item.data.imageAlt }}" class="w-full h-full object-cover transition-transform duration-500 hover:scale-[1.08]" />
        </div>
        <div class="p-6 max-md:p-4 max-md:flex max-md:flex-col max-md:justify-center">
          <h3 class="font-heading text-[1.25rem] font-bold text-coffee-dark mb-2">{{ item.data.title }}</h3>
          <p class="text-[0.9rem] text-text-light leading-relaxed mb-4">{{ item.data.description }}</p>
          <span class="font-heading text-[1.15rem] font-bold text-accent">{{ item.data.price }}</span>
        </div>
      </article>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="py-24 max-md:py-14 bg-cream" id="testimonials">
  <div class="max-w-[1200px] mx-auto px-6">
    <h2 class="font-heading text-[2.5rem] max-md:text-[1.85rem] font-bold text-coffee-dark text-center mb-4">{{ site.testimonials.title }}</h2>
    <p class="text-center text-text-light text-[1.1rem] max-md:text-[1rem] max-w-[750px] mx-auto mb-12 max-md:mb-8">{{ site.testimonials.subtitle }}</p>

    <div class="grid grid-cols-3 max-lg:grid-cols-2 max-md:grid-cols-1 gap-8">
      {% for item in collections.testimonials %}
      <blockquote class="bg-white rounded-card p-8 max-md:p-6 shadow-[0_4px_20px_rgba(0,0,0,0.05)] flex flex-col hover:-translate-y-1 transition-transform duration-300 {% if loop.last %}max-lg:col-span-2 max-lg:max-w-[500px] max-lg:mx-auto max-md:col-span-1 max-md:max-w-none{% endif %}">
        <div class="text-accent text-[1.2rem] tracking-[2px] mb-4">{{ item.data.stars }}</div>
        <p class="text-[1rem] leading-[1.7] text-text-light italic grow mb-6">"{{ item.content | safe | replace('<p>', '') | replace('</p>', '') | trim }}"</p>
        <footer class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-full bg-coffee text-white flex items-center justify-center font-bold">{{ item.data.avatar }}</div>
          <div>
            <cite class="block font-semibold not-italic text-text-main text-[0.95rem]">{{ item.data.name }}</cite>
            <span class="text-[0.8rem] text-text-light">{{ item.data.role }}</span>
          </div>
        </footer>
      </blockquote>
      {% endfor %}
    </div>
  </div>
</section>

<section class="py-24 max-md:py-14 bg-cream-alt" id="contact">
  <div class="max-w-[1200px] mx-auto px-6">
    <h2 class="font-heading text-[2.5rem] max-md:text-[1.85rem] font-bold text-coffee-dark text-center mb-4">{{ site.locations.title }}</h2>
    <p class="text-center text-text-light text-[1.1rem] max-md:text-[1rem] max-w-[750px] mx-auto mb-12 max-md:mb-8">{{ site.locations.subtitle }}</p>

    <div class="grid grid-cols-3 max-lg:grid-cols-2 max-[480px]:grid-cols-1 gap-8 max-md:gap-4">
      {% for location in collections.locations %}
      <article class="bg-white rounded-card overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.06)] hover:-translate-y-1.5 hover:shadow-[0_12px_32px_rgba(0,0,0,0.12)] transition-all duration-300">
        <div class="w-full aspect-[4/3] overflow-hidden">
          <img src="/{{ location.data.image }}" alt="{{ location.data.imageAlt }}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
        </div>
        <div class="p-5 max-md:p-3.5">
          <h3 class="font-heading text-[1.25rem] max-md:text-[1.05rem] font-bold text-coffee-dark mb-1.5">{{ location.data.name }}</h3>
          <p class="text-[0.95rem] max-md:text-[0.85rem] text-text-light">📍 {{ location.data.address }}</p>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="promo-bg relative py-20 max-md:py-14 text-white text-center" id="promo">
  <div class="absolute inset-0 bg-dark/[0.82]"></div>
  <div class="relative z-10 max-w-[1200px] mx-auto px-6">
    <h2 class="font-heading text-[2.75rem] max-md:text-[1.85rem] max-[480px]:text-[1.5rem] font-bold mb-4">{{ site.promo.title }}</h2>
    <p class="text-[1.15rem] max-md:text-[1rem] text-white/80 mb-6">{{ site.promo.text }}</p>
    <p class="font-heading text-[2rem] max-md:text-[1.3rem] max-[480px]:text-[1.1rem] font-bold italic text-accent bg-white/[0.08] inline-block px-8 max-md:px-5 max-[480px]:px-4 py-3 max-md:py-2.5 rounded-lg border-2 border-dashed border-accent mb-5">"{{ site.promo.phrase }}"</p>
    <p class="text-[0.9rem] text-white/50 mb-8">{{ site.promo.note }}</p>
    <a href="{{ site.promo.buttonHref }}" class="inline-block px-8 py-3.5 rounded-lg font-semibold bg-accent text-dark border-2 border-accent hover:bg-coffee hover:text-white hover:border-coffee transition-all duration-300 max-[480px]:text-[0.9rem]">{{ site.promo.buttonLabel }}</a>
  </div>
</section>

<footer class="bg-dark text-white/70 pt-16 max-md:pb-20">
  <div class="max-w-[1200px] mx-auto px-6 grid grid-cols-[2fr_1fr_1fr] max-lg:grid-cols-2 max-md:grid-cols-1 gap-12 max-lg:gap-8 pb-12 border-b border-white/10">
    <div class="max-lg:col-span-2 max-md:col-span-1">
      <a href="#top" class="font-heading text-[1.6rem] font-bold text-white tracking-wide">{{ site.brand.name }}<span class="text-accent">{{ site.brand.highlight }}</span></a>
      <p class="mt-3 text-[0.95rem] leading-relaxed">{{ site.footer.tagline }}</p>
    </div>

    <div>
      <h4 class="font-heading font-bold text-[1.1rem] text-white mb-4">Quick Links</h4>
      <ul class="flex flex-col gap-2 list-none p-0">
        {% for link in site.footer.quickLinks %}
        <li><a href="{{ link.href }}" class="text-[0.9rem] hover:text-accent transition-colors duration-300">{{ link.label }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div>
      <h4 class="font-heading font-bold text-[1.1rem] text-white mb-4">Follow Us</h4>
      <div class="flex flex-col gap-2">
        {% for social in site.footer.socialLinks %}
        <a href="{{ social.href }}" class="text-[0.9rem] hover:text-accent transition-colors duration-300" target="_blank" aria-label="{{ social.ariaLabel }}">{{ social.label }}</a>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="text-center py-6 text-[0.85rem] text-white/40 max-w-[1200px] mx-auto px-6">
    <p>&copy; {{ site.footer.copyright }}</p>
  </div>
</footer>

<div class="mascot" id="mascot" aria-label="Coffee cup mascot">
  <div class="mascot__bubble">
    <p>{{ site.mascot.message | safe }}</p>
  </div>
  <div class="mascot__character">
    <svg viewBox="0 0 120 140" xmlns="http://www.w3.org/2000/svg" class="block w-full h-auto">
      <g class="mascot__steam">
        <path d="M40 28 Q42 18 38 8" fill="none" stroke="#c4a882" stroke-width="2.5" stroke-linecap="round" opacity="0.6" />
        <path d="M55 25 Q57 12 53 2" fill="none" stroke="#c4a882" stroke-width="2.5" stroke-linecap="round" opacity="0.4" />
        <path d="M70 28 Q72 18 68 8" fill="none" stroke="#c4a882" stroke-width="2.5" stroke-linecap="round" opacity="0.5" />
      </g>
      <rect x="20" y="35" width="70" height="75" rx="12" fill="#6f4e37" />
      <ellipse cx="55" cy="50" rx="30" ry="8" fill="#4a3425" />
      <ellipse cx="55" cy="48" rx="28" ry="6" fill="#8B6544" />
      <path d="M55 45 Q50 40 48 43 Q46 46 55 51 Q64 46 62 43 Q60 40 55 45Z" fill="#f0dbb4" opacity="0.7" />
      <path d="M90 55 Q108 55 108 75 Q108 95 90 95" fill="none" stroke="#6f4e37" stroke-width="8" stroke-linecap="round" />
      <circle cx="42" cy="75" r="5" fill="#faf7f2" />
      <circle cx="68" cy="75" r="5" fill="#faf7f2" />
      <circle cx="43" cy="76" r="2.5" fill="#2c2420" />
      <circle cx="69" cy="76" r="2.5" fill="#2c2420" />
      <circle cx="44" cy="74" r="1" fill="#ffffff" />
      <circle cx="70" cy="74" r="1" fill="#ffffff" />
      <path d="M44 87 Q55 97 66 87" fill="none" stroke="#faf7f2" stroke-width="2.5" stroke-linecap="round" />
      <ellipse cx="36" cy="85" rx="5" ry="3" fill="#e8a0a0" opacity="0.5" />
      <ellipse cx="74" cy="85" rx="5" ry="3" fill="#e8a0a0" opacity="0.5" />
      <rect x="22" y="35" width="66" height="4" rx="2" fill="#8B6544" opacity="0.5" />
      <rect x="30" y="110" width="50" height="8" rx="4" fill="#5a3d28" />
      <ellipse cx="55" cy="122" rx="42" ry="8" fill="#d4a762" />
      <ellipse cx="55" cy="120" rx="38" ry="6" fill="#e8c88a" />
    </svg>
  </div>
</div>

<div class="hidden max-md:block fixed bottom-0 left-0 w-full z-[999] bg-coffee-dark p-3 shadow-[0_-4px_20px_rgba(0,0,0,0.2)]">
  <a href="{{ site.mobileCta.href }}" class="block text-center bg-accent text-dark font-bold text-[1rem] py-3.5 rounded-lg hover:bg-accent-light transition-colors duration-300">{{ site.mobileCta.label }}</a>
</div>

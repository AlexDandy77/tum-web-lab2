<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ site.meta.title }}</title>
    <meta name="description" content="{{ site.meta.description }}" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              coffee: { DEFAULT: "#6f4e37", dark: "#4a3425", light: "#a0795c" },
              accent: { DEFAULT: "#d4a762", light: "#f0dbb4" },
              cream: { DEFAULT: "#faf7f2", alt: "#f1ebe0" },
              dark: "#1a1210",
              "text-main": "#2c2420",
              "text-light": "#6b5e56"
            },
            fontFamily: {
              heading: ["Playfair Display", "Georgia", "serif"],
              body: ["Inter", "-apple-system", "sans-serif"]
            },
            borderRadius: {
              card: "12px"
            }
          }
        }
      };
    </script>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="font-body text-text-main bg-cream leading-relaxed">
    {{ content | safe }}
  </body>
</html>
